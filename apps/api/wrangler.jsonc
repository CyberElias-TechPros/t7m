{
  // Cloudflare Worker configuration — see README for provisioning steps.
  "name": "t7m-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",
  "observability": {
    "enabled": true
  },
  // Defaults for local dev. Override per environment with `.dev.vars` (local)
  // or `wrangler secret put` (production). Never commit real secrets.
  "vars": {
    "CORS_ORIGIN": "https://t7m-one.vercel.app",
    "PUBLIC_BASE_URL": "https://t7m-api.autumn-surf-21ec.workers.dev",
    "NOTIFY_EMAIL": "",
    "RESEND_API_KEY": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "t7m",
      // Replace with the ID returned by `wrangler d1 create t7m` before deploying.
      "database_id": "4d79433d-37da-4bc1-8783-1e3c1c61e8f9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "t7m-attachments"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      // Replace with the ID returned by `wrangler kv namespace create RATE_LIMIT`.
      "id": "e4de66b51f1d4f249c656631b026451a"
    }
  ]
}
